# Copiá este archivo a .env (PowerShell: Copy-Item .env.example .env) y `docker compose up`
# lo toma solo. Los mismos nombres sirven para desarrollo (docker-compose.yml) y producción
# (docker-compose.prod.yml).

# Entorno de la API: "dev" (permite los valores de ejemplo) o "prod" (activa el guard
# fail-fast de backend/app/core/config.py: la API NO arranca si DB_PASSWORD sigue en un valor
# de ejemplo). El compose de producción fija APP_ENV=prod por su cuenta; esto aplica a dev.
APP_ENV=dev

# Base de datos PostgreSQL 17 + PostGIS 3.5.
# DB_USER es el dueño de la base, porque la migración 0001 crea la extensión postgis. En
# producción cambiá SÍ O SÍ la contraseña: el compose de prod no arranca sin DB_PASSWORD y la
# API rechaza la de ejemplo.
DB_NAME=trazados
DB_USER=trazados
DB_PASSWORD=trazados-dev

# El nombre del estudio: va en la barra del portal y en la cabecera de la vista del cliente.
# Opcional: vacío, el portal dice «Sistema de trazados».
NOMBRE_ESTUDIO=

# Solo DESARROLLO: puerto del host para conectar un cliente (QGIS, pgAdmin, psql). Se publica
# únicamente en 127.0.0.1, nunca hacia la red. En producción la base no publica puertos.
DB_PORT_HOST=5432

# Puerto del host donde escucha Nginx, la única entrada (frontend + /api).
# Desarrollo: http://localhost:8080. Si el puerto está ocupado, cambialo acá.
# Producción: 80 si no se define (HTTPS todavía no está configurado).
HTTP_PORT=8080
